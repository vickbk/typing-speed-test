{
  "name": "typing-speed-test",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest --exclude \"**/*.spec.{js,ts,jsx,tsx}\"",
    "test:run": "pnpm test run",
    "preview": "vite preview",
    "circular": "madge . --circular",
    "coverage": "vitest run --coverage",
    "playwright-server": "vite dev --port=3000"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "bootstrap-icons": "^1.13.1",
    "html2canvas": "^1.4.1",
