    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "sass-embedded": "^1.104.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
